# Copy this file to `.env` (never commit `.env` itself) and fill in the
# values you need. Everything below has a working mocked default — the app
# runs fully offline, with no API keys, if you set nothing at all.

# Location discovery (Travel/Wildcard tab). Default: mock (canned fixtures,
# no network). No real provider is wired up yet.
# EXPO_PUBLIC_DISCOVERY_PROVIDER=mock

# Nutrition data (Pantry search/import). Default: mock (canned fixtures, no
# network). Set to usda_fdc to search real USDA FoodData Central data — get a
# free API key (instant, email only, no credit card) at
# https://fdc.nal.usda.gov/api-key-signup.html
# EXPO_PUBLIC_NUTRITION_PROVIDER=usda_fdc
# EXPO_PUBLIC_USDA_FDC_API_KEY=your-key-here
